{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate package on folder open",
      "type": "process",
      "command": "lune",
      "args": ["run", "scripts/dev/editor-open.lune.luau"],
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Build package",
      "type": "process",
      "command": "lune",
      "args": ["run", "scripts/build/run.lune.luau"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
