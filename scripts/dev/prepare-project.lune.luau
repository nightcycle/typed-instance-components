--!strict
-- Packages
local fs = require("@lune/fs")
local process = require("@lune/process")
-- Modules
local run = require("../shared/run")
-- Types
-- Constants
local headers: { [string]: string } = {
	["Generated/Dev/TypedInstanceComponents.luau"] = 'script.Parent._Index.TypedInstanceComponentsDev["typed-instance-components"]',
	["Generated/Dev/React.luau"] = "script.Parent.Parent.Parent.React",
}
-- References
-- Global Variables
-- Private Functions
local function main()
	fs.writeDir("Generated/Dev")
	for path, expression in headers do
		fs.writeFile(path, `return require({expression})\n`)
	end
	run("rojo", { "sourcemap", "dev.project.json", "--output", "Generated/sourcemap.json" })
	-- Exercise the same type-export tool required by installed Wally consumers.
	-- Dependency headers must export their types before the local peer shim forwards them.
	if process.args[1] == "--dependencies" then
		run("wally-package-types", { "--sourcemap", "Generated/sourcemap.json", "Packages", "DevPackages" })
	end
	run("wally-package-types", { "--sourcemap", "Generated/sourcemap.json", "Generated/Dev" })
	for path in headers do
		local source = fs.readFile(path):gsub("\r\n", "\n")
		local declaration, exports = source:match("^(local REQUIRED_MODULE = [^\n]+)\n(.*)\nreturn REQUIRED_MODULE%s*$")
		assert(declaration and exports, `Unexpected Wally type-header output: {path}`)
		fs.writeFile(
			path,
			table.concat({
				"--!strict",
				"-- Generated by scripts/dev/prepare-project.lune.luau. Do not edit.",
				"-- Packages",
				"-- Modules",
				declaration,
				"-- Types",
				(exports :: string):gsub("%s+$", ""),
				"-- Constants",
				"-- References",
				"-- Global Variables",
				"-- Private Functions",
				"-- Class",
				"return REQUIRED_MODULE",
				"",
			}, "\n")
		)
	end
	run("stylua", { "Generated/Dev" })
end
-- Class
main()
