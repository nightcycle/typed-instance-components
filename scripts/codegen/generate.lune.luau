--!strict
-- Packages
local fs = require("@lune/fs")
local serde = require("@lune/serde")
local process = require("@lune/process")
-- Modules
local Api = require("./api")
local getSource = require("./source")
local run = require("../shared/run")
-- Types
-- Constants
local generatedMarker = "-- Generated by scripts/codegen/generate.lune.luau."
local packageDirectory = "Generated/Package"
-- References
-- Global Variables
-- Private Functions
local function appendProperties(lines: { string }, typeName: string, props: { [string]: string }, names: { string })
	table.insert(lines, `export type {typeName} = \{`)
	for _, name in names do
		local propertyType = props[name]
		local optionalType = if propertyType:sub(-1) == "?" then propertyType else propertyType .. "?"
		table.insert(lines, `\t{name}: {optionalType},`)
	end
	table.insert(lines, "}")
end

local function writeOutputs(outputs: { [string]: string }, checking: boolean)
	if not checking then
		fs.writeDir(packageDirectory)
	end
	-- Format all modules in one invocation; file IO avoids truncated Windows pipes.
	local formatId = tostring(os.clock()):gsub("%D", "") .. "-" .. tostring(math.random(1, 2147483647))
	local formatDirectory = `Generated/Formatting/{formatId}`
	fs.writeDir(formatDirectory)
	for path, content in outputs do
		if path:match("%.luau$") then
			fs.writeFile(`{formatDirectory}/{assert(path:match("[^/]+$"))}`, content)
		end
	end
	local formatted = process.exec("stylua", { formatDirectory })
	assert(formatted.ok, formatted.stderr)
	for path in outputs do
		if path:match("%.luau$") then
			local formatPath = `{formatDirectory}/{assert(path:match("[^/]+$"))}`
			outputs[path] = fs.readFile(formatPath)
			assert(#outputs[path] > 0, "StyLua returned empty source")
			fs.removeFile(formatPath)
		end
	end
	fs.removeDir(formatDirectory)
	for path, content in outputs do
		if checking then
			assert(
				fs.isFile(path) and fs.readFile(path):gsub("\r\n", "\n") == content,
				`Generated file is stale: {path}`
			)
		elseif not fs.isFile(path) or fs.readFile(path):gsub("\r\n", "\n") ~= content then
			fs.writeFile(path, content)
		end
	end
	-- Remove retired generated modules, including the former Hosts/Properties bundles.
	-- Only direct files with this generator's marker are owned by this cleanup.
	for _, name in fs.readDir(packageDirectory) do
		local path = `{packageDirectory}/{name}`
		if fs.isFile(path) and outputs[path] == nil then
			assert(not checking, `Obsolete generated file: {path}`)
			assert(fs.readFile(path):find(generatedMarker, 1, true), `Refusing to remove unrecognized file: {path}`)
			fs.removeFile(path)
		end
	end
end

local function main()
	local source = getSource()
	local checking = process.args[1] == "--check"
	if not fs.isFile(source.snapshot) then
		assert(not checking, "Missing API snapshot; run lune run scripts/codegen/generate.lune.luau first")
		run("lune", { "run", "scripts/codegen/snapshot-api.lune.luau" })
	end
	local dump = serde.decode("json", fs.readFile(source.snapshot)) :: Api.Dump
	local index = Api.index(dump)
	local classes: { Api.Class } = {}
	for _, class in dump.Classes do
		if Api.inTree(index, class, source.roots) then
			table.insert(classes, class)
		end
	end
	table.sort(classes, function(a, b)
		return a.Name < b.Name
	end)
	local header =
		`--!strict\n{generatedMarker} API revision: {source.revision}. Do not edit.\n-- Internal package module; consumers must require the public package header.`
	local classSections = "-- References\n-- Global Variables\n-- Private Functions\n-- Class"
	local root = {
		header,
		"-- Packages",
		"local React = require(script.Parent.React)",
		"-- Modules",
		"local Lazy = require(script.Lazy)",
		"-- Types",
	}
	local componentType = { "type Components = {", "\tCustom: typeof(require(script.Custom))," }
	local loaders =
		{ "local loaders: { [string]: () -> unknown } = {", "\tCustom = function() return require(script.Custom) end," }
	local coverage = {
		"# Generated class coverage",
		"",
		`API revision: \`{source.revision}\`.`,
		"",
		"Each class has a private module and Properties type. Consumers use the package header's builders and ClassNameProperties aliases. Public, non-deprecated classes without NotCreatable or NotBrowsable tags have a host builder, loaded on first access. Engine rollout/permissions can still restrict creation.",
		"",
		"| Class | Superclass | Host builder |",
		"| --- | --- | --- |",
	}
	local outputs: { [string]: string } = {}
	local count = 0
	for _, class in classes do
		local props = Api.properties(index, class.Name)
		local names: { string } = {}
		for name in props do
			table.insert(names, name)
		end
		table.sort(names)
		local creatable = Api.creatable(class)
		local lines = { header, "-- Packages" }
		if creatable then
			table.insert(lines, "local React = require(script.Parent.Parent.React)")
		end
		table.insert(lines, "-- Modules")
		table.insert(lines, "-- Types")
		appendProperties(lines, "Properties", props, names)
		-- Keep the existing package-level aliases without requiring any class module.
		-- Luau erases these declarations from runtime bytecode.
		table.insert(root, "")
		appendProperties(root, `{class.Name}Properties`, props, names)
		if creatable then
			count += 1
			table.insert(lines, "-- Constants")
			table.insert(lines, "local VALID_PROPERTIES: { [string]: boolean } = {")
			for _, name in names do
				table.insert(lines, `\t{name} = true,`)
			end
			table.insert(lines, "}")
			table.insert(lines, "-- References\n-- Global Variables\n-- Private Functions")
			table.insert(lines, "local function append(defaults: Properties, props: Properties): Properties")
			table.insert(lines, "\tlocal result = {}")
			table.insert(lines, "\tfor name, value in props do")
			table.insert(lines, '\t\tif VALID_PROPERTIES[name :: string] or type(name) ~= "string" then')
			table.insert(lines, "\t\t\tresult[name] = value")
			table.insert(lines, "\t\tend")
			table.insert(lines, "\tend")
			table.insert(lines, "\tfor name, value in defaults do")
			table.insert(lines, "\t\tresult[name] = value")
			table.insert(lines, "\tend")
			table.insert(lines, "\treturn result")
			table.insert(lines, "end")
			table.insert(lines, "-- Class")
			table.insert(
				lines,
				`return function(defaults: Properties, props: Properties, children: React.ReactNode?): ("{class.Name}", Properties, React.ReactNode?)`
			)
			table.insert(lines, `\treturn "{class.Name}", append(defaults, props), children`)
			table.insert(lines, "end")
			table.insert(
				componentType,
				`\t{class.Name}: (defaults: {class.Name}Properties, props: {class.Name}Properties, children: React.ReactNode?) -> ("{class.Name}", {class.Name}Properties, React.ReactNode?),`
			)
			table.insert(loaders, `\t{class.Name} = function() return require(script.{class.Name}) end,`)
		else
			table.insert(lines, "-- Constants")
			table.insert(lines, classSections)
			table.insert(lines, "return table.freeze({})")
		end
		outputs[`{packageDirectory}/{class.Name}.luau`] = table.concat(lines, "\n") .. "\n"
		table.insert(coverage, `| {class.Name} | {class.Superclass} | {if creatable then "Yes" else "Types only"} |`)
	end
	table.insert(componentType, "}")
	table.insert(root, "")
	table.insert(root, table.concat(componentType, "\n"))
	table.insert(root, "-- Constants")
	table.insert(loaders, "}")
	table.insert(root, table.concat(loaders, "\n"))
	table.insert(root, classSections)
	table.insert(root, "return (Lazy(loaders) :: any) :: Components")
	outputs[`{packageDirectory}/init.luau`] = table.concat(root, "\n") .. "\n"
	outputs["Generated/classes.md"] = table.concat(coverage, "\n") .. "\n"
	writeOutputs(outputs, checking)
	print(`Generated {#classes} individual class modules, {count} host builders and a lazy package entry point.`)
end
-- Class
main()
